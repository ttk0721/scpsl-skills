<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Plain-.NET tests for TickrateFix's rule (src/TickratePolicy.cs) and config defaults
    (src/TickrateFixConfig.cs). Neither touches the game, so they compile for net10.0 without the
    server assemblies. The plugin class itself (Server.MaxTps, Application.targetFrameRate) is only
    compiled against the game and has to be checked on a live server.
    Run with "dotnet run" and this project file as the project argument; exit code 0 means every
    test passed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>TickrateFix.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/TickratePolicy.cs" Link="src/TickratePolicy.cs" />
    <Compile Include="../../src/TickrateFixConfig.cs" Link="src/TickrateFixConfig.cs" />
  </ItemGroup>
</Project>
