<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Plain-.NET self-test for SlKit.Polyfills (MinBy/MaxBy/DistinctBy/Chunk). The polyfills are pure
    LINQ-style code, so they compile unchanged for net10.0 and can be checked against the behaviour
    of the real .NET 6+ methods without the game assemblies. Run it with "dotnet run" on this project in Release.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Common/*.cs" Link="Common/%(Filename)%(Extension)" />
    <Compile Include="../../src/Runtime/Polyfills.cs" Link="Runtime/Polyfills.cs" />
  </ItemGroup>
</Project>
