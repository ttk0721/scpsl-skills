<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Plain-.NET tests for Core/ only. No game assemblies, no NuGet test framework.
    Run this project with "dotnet run" in Release (see writing-scpsl-plans). Exit code 0 means every test passed. This checks logic, not the server's Mono BCL:
    the net48 build against SCPSL_Data/Managed checks that.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Core/*.cs" Link="Core/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
