<Project>
  <!--
    Shared setup for every example project under examples/<name>/<Name>.csproj.

    Each example is its own tiny project so several authors (or CI jobs) can build in parallel
    without fighting over one obj/ directory. They compile against the same game assemblies as
    SlKit: SL_REFERENCES default, FrameworkPathOverride to the game's Managed folder, server BCL.
    SlKit is referenced as a built DLL (run tools/SlKit build first; build-all.py does).

      python3 examples/build-all.py
      dotnet build examples/<name>/<Name>.csproj -c Release -p:SL_REFERENCES="/path/to/SCPSL_Data/Managed"
  -->
  <Import Project="$(MSBuildThisFileDirectory)../tools/SlKit/Directory.Build.props" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <SlKitDll>$(MSBuildThisFileDirectory)../tools/SlKit/src/bin/Release/net48/SlKit.dll</SlKitDll>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SlKit"><HintPath>$(SlKitDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="LabApi"><HintPath>$(SL_REFERENCES)/LabApi.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(SL_REFERENCES)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(SL_REFERENCES)/Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CommandSystem.Core"><HintPath>$(SL_REFERENCES)/CommandSystem.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(SL_REFERENCES)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(SL_REFERENCES)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mirror"><HintPath>$(SL_REFERENCES)/Mirror.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="NorthwoodLib"><HintPath>$(SL_REFERENCES)/NorthwoodLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Pooling"><HintPath>$(SL_REFERENCES)/Pooling.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Net.Http"><HintPath>$(SL_REFERENCES)/System.Net.Http.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
